# GEMINI_API_KEY: Required for server-side Gemini AI financial parsing.
# The Gemini API key is never exposed to the client browser.
GEMINI_API_KEY=

# SUPABASE_URL: Supabase Project URL for server-side persistence to table 'invoicing_data'
SUPABASE_URL=

# SUPABASE_ANON_KEY: Supabase Anon API Key for server-side persistence
SUPABASE_ANON_KEY=
